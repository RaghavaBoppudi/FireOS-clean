    style="@style/Text.Header"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:format12Hour="EEEE d MMMM  |  HH:mm"
    android:format24Hour="EEEE d MMMM  |  HH:mm" />
