<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <include layout="@layout/screen" />

    <!-- all apps, edit and settings, along the bottom edge -->
    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/buttons_bottom"
        android:clipChildren="false"
        android:orientation="horizontal" />

    <!-- the screensaver: nothing but the time and date, which move -->
    <FrameLayout
        android:id="@+id/screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?ground"
        android:visibility="gone">

        <TextClock
            android:id="@+id/saver_clock"
            style="@style/Text.Clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE d MMMM  |  HH:mm"
            android:format24Hour="EEEE d MMMM  |  HH:mm" />
    </FrameLayout>
</FrameLayout>
