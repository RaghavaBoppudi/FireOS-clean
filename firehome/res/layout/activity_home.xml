<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.firehome.WallpaperView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        layout="@layout/header"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_size"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/margin"
        android:layout_marginTop="@dimen/bar_top" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="@dimen/buttons_end"
        android:layout_marginTop="@dimen/bar_top"
        android:clipChildren="false"
        android:orientation="horizontal">

        <com.firehome.GlyphButton
            android:id="@+id/button_all_apps"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:contentDescription="@string/all_apps"
            android:src="@drawable/ic_applications" />

        <com.firehome.GlyphButton
            android:id="@+id/button_edit"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:layout_marginStart="@dimen/button_gap"
            android:contentDescription="@string/edit_dock"
            android:src="@drawable/ic_edit" />

        <com.firehome.GlyphButton
            android:id="@+id/button_settings"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:layout_marginStart="@dimen/button_gap"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/dock_bottom"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- the instructions while the dock is edited -->
        <com.firehome.FrostedPanel
            android:id="@+id/banner_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/caption_gap"
            android:visibility="gone">

            <TextView
                android:id="@+id/banner"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/banner_padding_v"
                android:paddingEnd="@dimen/banner_padding_h"
                android:paddingStart="@dimen/banner_padding_h"
                android:paddingTop="@dimen/banner_padding_v" />
        </com.firehome.FrostedPanel>

        <com.firehome.FrostedPanel
            android:id="@+id/panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:layout_marginEnd="@dimen/dock_margin"
            android:layout_marginStart="@dimen/dock_margin">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/dock_padding_v"
                    android:paddingEnd="@dimen/dock_padding_h"
                    android:paddingStart="@dimen/dock_padding_h"
                    android:paddingTop="@dimen/dock_padding_v" />

                <!-- below the dock in edit mode: a dash, then the apps that can be added -->
                <View
                    android:id="@+id/dash"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dash_height"
                    android:layout_marginEnd="@dimen/dock_padding_h"
                    android:layout_marginStart="@dimen/dock_padding_h"
                    android:background="@color/dash"
                    android:visibility="gone" />

                <ScrollView
                    android:id="@+id/addable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:fadingEdgeLength="@dimen/fade"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/addable_grid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/dock_padding_v"
                        android:paddingEnd="@dimen/dock_padding_h"
                        android:paddingStart="@dimen/dock_padding_h"
                        android:paddingTop="@dimen/dock_padding_v" />
                </ScrollView>
            </LinearLayout>
        </com.firehome.FrostedPanel>
    </LinearLayout>

    <TextView
        android:id="@+id/credit"
        style="@style/Text.Credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="@dimen/credit_bottom"
        android:layout_marginEnd="@dimen/margin" />

    <!-- the screensaver: the wallpaper blurred as far as it goes, and the time and date, which move -->
    <FrameLayout
        android:id="@+id/screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ground"
        android:visibility="gone">

        <ImageView
            android:id="@+id/saver_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/saver_veil" />

        <LinearLayout
            android:id="@+id/saver_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/saver_time"
                style="@style/Text.SaverTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm" />

            <TextClock
                android:id="@+id/saver_date"
                style="@style/Text.SaverDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE d MMMM"
                android:format24Hour="EEEE d MMMM" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
