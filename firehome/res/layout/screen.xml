<?xml version="1.0" encoding="utf-8"?>
<!-- What every screen has: a shelf of discs in the middle, and the date and time above it -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/shelf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical" />
    </ScrollView>

    <TextClock
        style="@style/Text.Clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/clock_top"
        android:format12Hour="EEEE d MMMM  |  HH:mm"
        android:format24Hour="EEEE d MMMM  |  HH:mm" />
</merge>
