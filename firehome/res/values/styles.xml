<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every look's window is black from the first frame, with no transition of its own, and the screen comes up out of
         the black (see HomeActivity), so opening the home never flashes light or slides in -->
    <style name="Base" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/window_black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Light" parent="Base">
        <item name="ground">@color/ground_light</item>
        <item name="discTop">@color/disc_top_light</item>
        <item name="discBottom">@color/disc_bottom_light</item>
        <item name="discRimTop">@color/rim_top_light</item>
        <item name="discRimBottom">@color/rim_bottom_light</item>
        <item name="discLift">@color/lift_light</item>
        <item name="shadowAmbient">@color/shadow_ambient_light</item>
        <item name="shadowSpot">@color/shadow_spot_light</item>
        <item name="ink">@color/ink_light</item>
        <item name="textShadow">@color/shadow_text_none</item>
        <item name="inkDim">@color/ink_dim_light</item>
    </style>

    <style name="Dark" parent="Base">
        <item name="ground">@color/ground_dark</item>
        <item name="discTop">@color/disc_top_dark</item>
        <item name="discBottom">@color/disc_bottom_dark</item>
        <item name="discRimTop">@color/rim_top_dark</item>
        <item name="discRimBottom">@color/rim_bottom_dark</item>
        <item name="discLift">@color/lift_dark</item>
        <item name="shadowAmbient">@color/shadow_ambient_dark</item>
        <item name="shadowSpot">@color/shadow_spot_dark</item>
        <item name="ink">@color/ink_dark</item>
        <item name="textShadow">@color/shadow_text_none</item>
        <item name="inkDim">@color/ink_dim_dark</item>
    </style>

    <!-- With a wallpaper there is one look, not two: white ink and shadowed text over the picture, and flat discs of frosted glass, with no shadow -->
    <style name="Photo" parent="Base">
        <item name="ground">@color/ground_photo</item>
        <item name="discLift">@color/lift_photo</item>
        <item name="shadowAmbient">@color/shadow_none</item>
        <item name="shadowSpot">@color/shadow_none</item>
        <item name="ink">@color/ink_photo</item>
        <item name="textShadow">@color/shadow_text_photo</item>
        <item name="inkDim">@color/ink_dim_photo</item>
    </style>

    <!-- Three sizes of type carry the whole interface -->
    <style name="Text">
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?ink</item>
        <item name="android:shadowColor">?textShadow</item>
        <item name="android:shadowRadius">8</item>
        <item name="android:shadowDy">1</item>
    </style>

    <!-- the date at the top left and the time at the top right of Home, both together on the screensaver, and the name of a screen in its place -->
    <style name="Text.Clock">
        <item name="android:textSize">@dimen/text_clock</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <!-- the name under a disc, and a line of instructions -->
    <style name="Text.Label">
        <item name="android:textSize">@dimen/text_label</item>
    </style>

    <!-- a setting's value, under its name -->
    <style name="Text.Caption" parent="Text.Label">
        <item name="android:textColor">?inkDim</item>
    </style>
</resources>
