<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type -->
    <dimen name="text_clock">18sp</dimen>
    <dimen name="text_label">14sp</dimen>

    <!-- A slot: the room above its disc for the disc to grow into, the disc, and under it the room for a name and a
         value. Every slot is the same, so a row of them lines up whatever each one has to say -->
    <dimen name="slot_width">88dp</dimen>
    <dimen name="slot_top">14dp</dimen>
    <dimen name="slot_height">124dp</dimen>
    <dimen name="disc">52dp</dimen>
    <dimen name="rim">1dp</dimen>
    <dimen name="button_glyph">20dp</dimen>
    <dimen name="name_gap">10dp</dimen>
    <dimen name="elevation_rest">1.5dp</dimen>
    <dimen name="elevation_selected">8dp</dimen>
    <!-- how far a disc taken off the dock rises -->
    <dimen name="lift">32dp</dimen>
    <!-- how far the dock shakes when it is asked for more, or less, than it can give -->
    <dimen name="shake">10dp</dimen>

    <!-- The edges of the screen: the margin also keeps clear of TV overscan -->
    <dimen name="margin">56dp</dimen>
    <dimen name="buttons_bottom">28dp</dimen>
    <dimen name="clock_top">40dp</dimen>
    <!-- A grid of many rows keeps this clear of the clock above and the buttons below, so it stays centred -->
    <dimen name="grid_inset">96dp</dimen>
    <!-- the line of instructions sits this far below the middle of the screen, clear of the names under the discs -->
    <dimen name="hint_top">120dp</dimen>
    <dimen name="button_gap">8dp</dimen>

    <!-- the launch cover: a spinner and its caption, centred -->
    <dimen name="spinner_size">36dp</dimen>
    <dimen name="spinner_stroke">4dp</dimen>
    <dimen name="spinner_gap">18dp</dimen>
    <dimen name="saver_margin">120dp</dimen>
</resources>
